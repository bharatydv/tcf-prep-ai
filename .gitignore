node_modules/
# Every .env variant, not just the three that used to be listed. A .env.bak on
# the deploy VM was untracked but NOT ignored, so one `git add -A` there would
# have committed the production payment key and the database password.
.env
.env.*
.env.bak
.envy
!.env.example
!.env.*.example
__pycache__/
*.pyc
.venv/
frontend/build/
*.log
.vscode/

venv312/
backend/venv312/
venv/
*.save
*.save.*

# Database dumps. docker-compose mounts ./backups into the backup container, so
# on the deploy VM this directory fills with pg_dumps of production — every
# learner's e-mail and password hash, everything they have ever written or said,
# their phone numbers, and the subscriptions and invoices tables.
#
# It was untracked but NOT ignored, which is the same trap the .env.bak rule
# above exists to close: one `git add -A` run on the VM and the entire database
# is a public commit. Ignore the directory AND the file shapes, because a dump
# copied somewhere else for a restore test is exactly as sensitive.
backups/
*.sql.gz
*.sql
*.dump

# Local compose overrides stay on the machine that needs them.
docker-compose.override.yml

# Raw question exports and the media staged out of them. The listening audio is
# 1,560 files and 1.8 GB — far past what belongs in a git history, and it does
# not need to be there: scripts/build_content.py rebuilds backend/media/ from
# the exports, and in production the audio is served from object storage
# (MEDIA_BASE_URL) rather than from the repo at all.
#
# backend/content/*.json is NOT ignored. Those two files are the question bank
# itself — 3 MB each, the thing the server actually seeds from — so they are
# committed and a deploy needs neither the exports nor this script.
fuck_tcf_export/
fuck_tcf_reading_export/
backend/media/
