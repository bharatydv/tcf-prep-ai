# ---------------------------------------------------------------- core ------
# "production" turns on Secure cookies and refuses to boot on default secrets.
ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tcf_prep_ai
DB_NAME=tcf_prep_ai

# 32+ random characters. Required in production; the app will not start with
# the built-in default.
JWT_SECRET=change-me-in-prod

# Comma-separated list of allowed origins. The first entry is treated as the
# canonical site and is used to build the links inside emails.
FRONTEND_URL=http://localhost:3000
# Override only if the public address differs from the first FRONTEND_URL entry.
# PUBLIC_URL=https://prepfrancais.com

# Seeded on first start. Required in production; the built-in default is
# refused at boot.
ADMIN_EMAIL=admin@frenchcorrector.com
ADMIN_PASSWORD=admin123!

# ------------------------------------------------------------------ sms ----
# Second confirmation channel. Without all three set, the code is written to
# the log instead of being sent, and in production the SMS option answers 503
# rather than pretending a message went out.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# PHONE_CODE_TTL_MINUTES=10

# ------------------------------------------------------------- providers ----
# At least one grading key is required, or grading fails with a 503 and no
# credit is charged.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
ASSEMBLYAI_API_KEY=

# Per-task provider. The Admin panel overrides these at runtime.
WRITING_GRADER_PROVIDER=anthropic
SPEAKING_GRADER_PROVIDER=anthropic
TRANSCRIBE_PROVIDER=openai

# Models (all current; override if you have different access).
# ANTHROPIC_MODEL=claude-haiku-4-5
# OPENAI_GRADER_MODEL=gpt-4o-mini
# GEMINI_GRADER_MODEL=gemini-2.5-flash-lite
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# GROQ_GRADER_MODEL=openai/gpt-oss-120b
# GROQ_TRANSCRIBE_MODEL=whisper-large-v3
# DEEPSEEK_GRADER_MODEL=deepseek-v4-flash

# ------------------------------------------------------------------ email ---
# Without SMTP_HOST, reset and verification links are written to the log
# instead of sent. That is fine locally; in production /auth/forgot-password
# answers 503 rather than pretending a message went out.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=prepfrancais <bonjour@prepfrancais.com>
SMTP_STARTTLS=true
# RESET_TTL_MINUTES=60
# VERIFY_TTL_HOURS=48

# ------------------------------------------------------------ capacity ------
# Concurrent provider calls. These block on network I/O rather than CPU, so the
# pool can safely exceed the core count. Leaving it at asyncio's default of
# min(32, cpu+4) capped grading at six users at once on a 2-vCPU box.
AI_MAX_CONCURRENCY=32
# Every provider SDK waits forever by default; a stalled socket would otherwise
# consume a worker thread for the life of the process.
AI_HTTP_TIMEOUT=60
SPEAKING_MAX_WAIT_SECONDS=180
# GRADER_MAX_TOKENS=4000

# Database pool. Sized explicitly rather than inheriting SQLAlchemy's 5 + 10.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# ------------------------------------------------------------- proxying -----
# X-Forwarded-For is trusted only from these addresses. Leave empty when the
# API is reached directly; set to the proxy's address, or "*" when a managed
# load balancer guarantees the header. Trusting it unconditionally let an
# anonymous caller rotate the value and slip past the login rate limit.
TRUSTED_PROXIES=

# ---------------------------------------------------------- billing --------
# Cashfree recurring subscriptions. Leave CASHFREE_APP_ID empty and the pricing
# page keeps showing "payment not open yet" instead of dead buy buttons —
# /api/billing/plans reports `configured: false` and the UI follows it.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox | production. Decides the API host unless CASHFREE_BASE_URL is set.
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2025-01-01
# CASHFREE_BASE_URL=https://sandbox.cashfree.com/pg
# Cashfree signs webhooks with the client secret unless a separate signing
# secret is configured in the dashboard. Wrong value = every webhook rejected
# with 401 and nobody ever gets premium, so check this first if payments land
# at Cashfree but the account stays on the free trial.
CASHFREE_WEBHOOK_SECRET=

# Subscription plans are INR by default; a non-INR currency needs Cashfree's
# international product enabled on the account. If mandate creation fails with
# a currency error, this is the first thing to change.
BILLING_CURRENCY=USD
# Prices, changeable without touching code. The plan id at Cashfree embeds the
# amount, so changing one of these mints a new plan rather than leaving new
# subscribers on an immutable plan that no longer matches the pricing page.
# BILLING_PRICE_WEEK=20
# BILLING_PRICE_MONTH=80
# BILLING_PRICE_QUARTER=220
# The introductory rate, charged to an account that has never paid and then
# held for the life of that subscription.
# BILLING_FIRST_WEEK=15
# BILLING_FIRST_MONTH=60
# BILLING_FIRST_QUARTER=180
# The mandate is authorised with a token charge that is refunded immediately.
# BILLING_AUTH_AMOUNT=1
# How many cycles one mandate may run before the learner re-authorises.
# BILLING_MAX_CYCLES=60

# ------------------------------------------------------ container ports ----
# Host ports the containers publish on. Defaults suit a box where nothing else
# owns :80. The GCP VM runs its own nginx there proxying to 3000/5000, so it
# sets FRONTEND_PORT=3000 and BACKEND_PORT=5000 instead of editing
# docker-compose.yml — which used to conflict on every single pull.
# FRONTEND_PORT=80
# BACKEND_PORT=8000
