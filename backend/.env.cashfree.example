# Copy to backend/.env.cashfree and fill in your SANDBOX keys.
# That filename matches the .env.* rule in .gitignore, so it cannot be
# committed by accident. Never put production keys here.
#
# Cashfree dashboard -> Developers -> API Keys, with the Sandbox toggle on.
# Sandbox secrets start cfsk_ma_test_ ; production ones start cfsk_ma_prod_.
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
BILLING_CURRENCY=USD
