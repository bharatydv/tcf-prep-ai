# The API is served from the SAME origin as the app — nginx proxies /api to the
# backend in production, and package.json's `proxy` field does it in
# development — so there is no backend URL to configure here.
#
# REACT_APP_BACKEND_URL used to live in this file and was read by nothing:
# lib/api.js hardcodes a relative "/api". Setting it changed no behaviour,
# which is worse than it not existing, so it is gone.

# The canonical site address. Used to build canonical tags, Open Graph URLs and
# the sitemap. Only needs setting when building for somewhere other than
# https://prepfrancais.com.
# REACT_APP_SITE_URL=https://prepfrancais.com

# Point the sitemap generator at a running backend so blog slugs are included.
# SITEMAP_API=http://localhost:8000

# The community groups, shown as a floating button on every page and on the
# "check your inbox" screen after registering. Both are optional and
# independent: set one and it becomes a single direct link, set both and the
# floating button opens a small chooser, set neither and nothing renders
# anywhere — no empty heading and no dead button.
#
# Paste the INVITE LINK, not the group name. Anything that is not an absolute
# https: URL is ignored rather than rendered, so a mistake here shows no button
# instead of a broken one (see src/lib/community.js).
#
# These are baked in at build time like every REACT_APP_* value, so changing a
# link means rebuilding the frontend — which is the trade for not having the
# invite hardcoded in a component.
# REACT_APP_WHATSAPP_URL=https://chat.whatsapp.com/XXXXXXXXXXXXXXXXXXXX
# REACT_APP_TELEGRAM_URL=https://t.me/XXXXXXXXXXX
