{
  "name": "tcf-prep-ai-frontend",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "axios": "^1.7.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
