  "devDependencies": {
    "tailwindcss": "^3.4.14",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "react-snap": "^1.23.0"
  },
  "scripts": {
    "start": "craco start",
    "build": "craco build",
    "test": "craco test",
    "build:prerender": "node scripts/generate-sitemap.js && node scripts/prerender-snapshot.js && craco build && node scripts/prerender-shell.js save && react-snap && node scripts/prerender-shell.js prune && node scripts/prerender-snapshot.js clean",
    "prebuild": "node scripts/generate-sitemap.js",
    "sitemap": "node scripts/generate-sitemap.js"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "proxy": "http://localhost:8000",
